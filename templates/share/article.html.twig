{# templates/share/article.html.twig #}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <link rel="icon" type="image/x-icon" href="/favicon_madagascar_heart.ico">
    <title>{{ title }}</title>

    {# Open Graph #}
    <meta property="og:type" content="article">
    <meta property="og:title" content="{{ title }}">
    <meta property="og:description" content="{{ description }}">
    <meta property="og:image" content="{{ app.request.schemeAndHttpHost }}/favicon_madagascar_heart.ico">
    <meta property="og:url" content="{{ redirectUrl }}">

    {# Twitter #}
    {# <meta name="twitter:card" content="summary_large_image"> #}
    <meta name="twitter:title" content="{{ title }}">

    {# Redirect real users  #}
    <script>
        window.location.href = "{{ redirectUrl }}";
    </script>
</head>
<body>
    <noscript>
        <a href="{{ redirectUrl }}">Continue</a>
    </noscript>
    <h1>{{ title }}</h1>
    <div>
        {% autoescape %}
        {{ description|raw }}
        {% endautoescape %}
    </div>
</body>
</html>
